# Copia este fichero como .env (que no se sube) y rellénalo.
# Con Supabase en local (npm run db:start), los dos valores salen de: npx supabase status
# Con el proyecto del grupo en la nube: panel de Supabase → Settings → API Keys (la clave PUBLICABLE).
# Aquí NUNCA va la clave secreta (sb_secret_…): se salta todas las políticas.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
